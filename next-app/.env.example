###############################################
# Next.js Portfolio — Environment Variables   #
# Rename this file to: .env.local             #
# Do NOT commit your real secrets.            #
###############################################

# Gmail address used by the contact API route to send/receive messages.
# Recommended: use a Gmail App Password (not your normal password).
EMAIL_USER="your.email@example.com"

# Gmail App Password or SMTP password for EMAIL_USER.
# Create at https://myaccount.google.com/apppasswords (2FA required)
EMAIL_PASS="your-app-password"

# Notes:
# - Keep this file named ".env.local" in development; Next.js ignores it by default.
# - In production (e.g., Vercel), set these as project environment variables.
